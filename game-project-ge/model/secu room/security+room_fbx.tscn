[node name="RulesBoard" parent="." unique_id=185386984 instance=ExtResource("3_xxi61")]
transform = Transform3D(0.054134317, 0, 0, 0, 0.09987034, 0, 0, 0, 0.034, 0.0037966603, -0.0960824, -0.2374235)
rules_text = "1.พนักงานที่นี้มีคนเดียวถ้ามีเสียงเคาะประตู ห้ามเปิดประตูเด็ดขาดให้เคาะกลับ 3 ครั้งแทน
2.ก่อนจะเข้าโกดังให้เคาะประตูก่อนทุกครั้งถ้าเคาะแล้วไม่มีเสียงอะไรถึงเข้าไปได้
3.ถ้ามีเสียงร้องไห้ให้รีบกลับห้องพักให้เร็วที่สุดแล้วรอจนกว่าเสียงจะเงียบ
4.ถ้าห้องพักล็อกให้ไปเอากุญแจที่โกดัง2 แล้วเอาไปคืนด้วยทันทีnow
5.ถ้าประตูโกดังล็อกเองให้ตะโกนเสียงแหลมแล้วประตูจะเปิด
6.ห้ามเข้าโกดังสองตอนตี4
7.ห้ามใช้เสียงและเคาะประตูตอนตี3"

